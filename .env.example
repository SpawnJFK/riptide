# Copy to .env (start.ps1 loads it). All values optional; leave a path empty to use the default.
RIPTIDE_HOST=127.0.0.1
RIPTIDE_PORT=8787
# Leave empty for loopback. Required (or auto-generated) when RIPTIDE_HOST is not loopback.
RIPTIDE_TOKEN=
# Defaults on Windows (see backend/riptide/config.py):
#   data        %LOCALAPPDATA%\Riptide\data
#   downloads   %USERPROFILE%\Downloads\Riptide
#   incomplete  %USERPROFILE%\Downloads\Riptide\Incomplete
#   watch       %USERPROFILE%\Downloads\Riptide\Watch
#   dev cache   %LOCALAPPDATA%\Riptide\cache   (demo swarm, smoke payloads)
RIPTIDE_DATA_DIR=
RIPTIDE_DOWNLOAD_DIR=
RIPTIDE_INCOMPLETE_DIR=
RIPTIDE_WATCH_DIR=
RIPTIDE_CACHE_DIR=
RIPTIDE_BT_PORT=6881
RIPTIDE_DHT=1
RIPTIDE_UPNP=1
